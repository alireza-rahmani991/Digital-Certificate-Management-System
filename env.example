# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

# JDBC URL for PostgreSQL.
# When running via `docker compose`, use "db" as the host (the service name in docker-compose.yml).
# When running against a local/standalone Postgres, use "localhost" or your DB host instead.
DB_URL=jdbc:postgresql://db:5432/digital_certificate

DB_USERNAME=usernamehere
DB_PASSWORD=passwordhere
